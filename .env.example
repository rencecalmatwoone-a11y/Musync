
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Server only: required for persistent Spotify login on Vercel.
# Run supabase/migrations/20260905_server_sessions.sql first.
SUPABASE_SERVICE_ROLE_KEY=

SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

SPOTIFY_LOCAL_REDIRECT_URI=http://127.0.0.1:5173/api/spotify/callback
SPOTIFY_PRODUCTION_REDIRECT_URI=

# Set both production values in Vercel after choosing your live domain.
# PUBLIC_BASE_URL=https://your-project.vercel.app
# SPOTIFY_PRODUCTION_REDIRECT_URI=https://your-project.vercel.app/api/spotify/callback
PUBLIC_BASE_URL=
