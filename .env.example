# Musync — Supabase integration
#
# Copy this file to `.env` and fill in your project credentials found under
# Project Settings -> API in your Supabase dashboard. The server reads this
# file at startup and injects the values into the browser config module
# `/src/supabase/config.js`.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Musync — Spotify Web API (required)
#
# Required for dynamic music. The server uses the Client Credentials flow, so
# these values NEVER leave the server (they are not injected into the browser).
# Create an app at https://developer.spotify.com/dashboard to get credentials.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Add both callback URLs to your Spotify dashboard Redirect URIs.
SPOTIFY_LOCAL_REDIRECT_URI=http://127.0.0.1:5173/api/spotify/callback
SPOTIFY_PRODUCTION_REDIRECT_URI=https://your-deployed-domain.com/api/spotify/callback

# Optional public URL used by hosted platforms when NODE_ENV=production.
PUBLIC_BASE_URL=https://your-deployed-domain.com
